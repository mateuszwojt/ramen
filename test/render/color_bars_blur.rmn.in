magic: Ramen composition
version: 1
start_frame: 1
end_frame: 1
frame: 1
frame_rate: 25
autokey: false
format: [640, 360, 1]
nodes:
  - class: [image.builtin.color_bars, 1, 0]
    name: "bars"
    comp_pos: [0, 0]
    params:
      - id: format
        value: [640, 360, 1]
  - class: [image.builtin.gamma, 1, 0]
    name: "gamma"
    comp_pos: [0, 80]
    params:
      - id: gamma
        value: 2.2
  - class: [image.builtin.gauss_blur, 1, 0]
    name: "blur"
    comp_pos: [0, 160]
    params:
      - id: stddev
        value: [6, 6]
  - class: [image.builtin.img.image_seq_output, 1, 0]
    name: "out"
    comp_pos: [0, 240]
    params:
      - id: output
        value: "@OUTPUT_DIR@/out.%04d.exr"
edges:
  - [bars, gamma, 0]
  - [gamma, blur, 0]
  - [blur, out, 0]
